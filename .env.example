# ==============================================================================
# Mem0 长期记忆系统环境变量配置模板
# 注意：严禁提交真实 API Key 到 Git；可复制为 gitignored 的 .loopx/memory/.env 或 .env.local
# ==============================================================================

# 运行模式: auto (检测到 MEM0_API_KEY 自动用 platform，否则 oss) | oss | platform
MEM0_MODE=oss

# 方案 A: 本地 OSS 模式（默认，SQLite 向量库 + 历史库落在 .loopx/memory/）
# 使用 Google Gemini（推荐：当前环境已验证支持 gemini-embedding-001 + gemini-2.5-flash-lite）
GOOGLE_API_KEY=

# 或使用 OpenAI / OpenAI 兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# 方案 B: Mem0 Platform 云端模式（设置后 auto 模式优先使用云端托管）
# MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxx
# MEM0_API_URL=https://api.mem0.ai

# 可选模型与预算调优（已设置合理默认值控制 Token 消耗）
# MEM0_EMBED_PROVIDER=google
# MEM0_EMBED_MODEL=gemini-embedding-001
# MEM0_EMBED_DIMENSION=768
# MEM0_LLM_PROVIDER=google
# MEM0_LLM_MODEL=gemini-2.5-flash-lite
# MEM0_TOP_K=5
# MEM0_MIN_SEMANTIC_SCORE=0.42
# MEM0_MAX_CONTEXT_TOKENS=800
# MEM0_MAX_ITEM_CHARS=280
# MEM0_HOOK_TIMEOUT_MS=2500

# 隐私开关：默认关闭 mem0ai 遥测上报
MEM0_TELEMETRY=false
